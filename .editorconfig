# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Matches multiple file extensions
[*.{py,pyw,js,ts,jsx,tsx,vue,css,scss,html,htm,xml,json,md,yml,yaml,toml,ini,cfg,conf}]
indent_style = space
indent_size = 4

# Matches Django templates
[*.html]
indent_size = 2

# Matches JavaScript and TypeScript files
[*.{js,ts,jsx,tsx}]
indent_size = 2

# Matches CSS and SCSS files
[*.{css,scss}]
indent_size = 2

# Matches Makefiles
[Makefile]
indent_style = tab

# Matches Batch files (Windows)
[*.bat]
end_of_line = crlf

# Matches Git configuration
[.git*]
indent_style = space
indent_size = 2